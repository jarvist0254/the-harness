{
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "modelProviders": {
    "openai": [
      {
        "id": "qwen3.8-flash",
        "name": "[ModelStudio Token Plan for Global/Intl] qwen3.8-flash",
        "capabilities": {
          "reasoning": {
            "thinking": true,
            "efforts": [
              "low",
              "medium",
              "xhigh"
            ],
            "defaultEffort": "xhigh",
            "disableField": "reasoning_effort"
          }
        },
        "baseUrl": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
        "envKey": "BAILIAN_TOKEN_PLAN_API_KEY",
