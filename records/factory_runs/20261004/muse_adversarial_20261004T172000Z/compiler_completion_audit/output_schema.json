{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings", "safety_checks"],
  "properties": {
    "verdict": {"type": "string", "enum": ["SUPPORT_WITH_LIMITS", "REQUEST_CHANGES", "NEEDS_DISCUSSION"], "minLength": 1, "maxLength": 128},
    "findings": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["region", "exact_source", "reason", "minimal_fix"],
        "properties": {
          "region": {"type": "string", "minLength": 1, "maxLength": 512},
          "exact_source": {"type": "string", "minLength": 1, "maxLength": 16384},
          "reason": {"type": "string", "minLength": 1, "maxLength": 16384},
          "minimal_fix": {"type": "string", "minLength": 1, "maxLength": 16384}
        }
      }
    },
    "safety_checks": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 8192}}
  }
}
