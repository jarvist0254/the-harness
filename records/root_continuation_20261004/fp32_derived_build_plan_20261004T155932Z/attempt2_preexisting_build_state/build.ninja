build bin\ggml.dll ggml\src\ggml.lib: CXX_SHARED_LIBRARY_LINKER__ggml_Release ggml\src\CMakeFiles\ggml.dir\ggml-backend-dl.cpp.obj ggml\src\CMakeFiles\ggml.dir\ggml-backend-reg.cpp.obj | ggml\src\ggml-cpu.lib ggml\src\ggml-rpc\ggml-rpc.lib ggml\src\ggml-vulkan\ggml-vulkan.lib ggml\src\ggml-base.lib || bin\ggml-base.dll bin\ggml-cpu.dll bin\ggml-rpc.dll bin\ggml-vulkan.dll
  CONFIG = Release
  LANGUAGE_COMPILE_FLAGS = /DWIN32 /D_WINDOWS /EHsc /O2 /Ob2 /DNDEBUG -MD
  LINK_FLAGS = /machine:x64 /INCREMENTAL:NO
  LINK_LIBRARIES = ggml\src\ggml-cpu.lib  ggml\src\ggml-rpc\ggml-rpc.lib  ggml\src\ggml-vulkan\ggml-vulkan.lib  ggml\src\ggml-base.lib  kernel32.lib user32.lib gdi32.lib winspool.lib shell32.lib ole32.lib oleaut32.lib uuid.lib comdlg32.lib advapi32.lib
  OBJECT_DIR = ggml\src\CMakeFiles\ggml.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  RESTAT = 1
  TARGET_COMPILE_PDB = ggml\src\CMakeFiles\ggml.dir\
  TARGET_FILE = bin\ggml.dll
  TARGET_IMPLIB = ggml\src\ggml.lib
  TARGET_PDB = bin\ggml.pdb

