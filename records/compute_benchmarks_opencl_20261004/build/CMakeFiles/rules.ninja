#############################################
# Rule to generate ninja dyndep files for CXX.

rule CXX_DYNDEP__mutex_comparison_Release
  command = C:\Users\thoma\AppData\Local\Programs\Python\Python310\Lib\site-packages\cmake\data\bin\cmake.exe -E cmake_ninja_dyndep --tdi=source\tools\mutex_comparison\CMakeFiles\mutex_comparison.dir\CXXDependInfo.json --lang=CXX --modmapfmt=msvc --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
